{
  "name": "study-hall-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "desktop:prepare": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:win": "npm run desktop:prepare && electron-builder --config electron-builder.json --win portable --x64",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "express": "^5.1.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Hamdars — Persian study hall manager",
  "author": "Hamdars",
  "main": "desktop-build/main.mjs"
}
